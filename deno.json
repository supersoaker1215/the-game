{
  "lint": {
    "include": [
      "cards.js",
      "tricks.js",
      "abilities.js",
      "decks.js",
      "engine/combat.js",
      "error-reporter.js",
      "game.js",
      "perf-overlay.js",
      "ai.js",
      "logger.js",
      "multiplayer.js",
      "roguelite.js",
      "ui.js",
      "fx.js",
      "audio.js",
      "ui-2v2.js",
      "ui-menu.js",
      "menu-scene.js",
      "tutorial.js",
      "tournament.js",
      "voice.js",
      "leaderboard.js",
      "board-v2.js",
      "card-art-accent.js",
      "card-art-manifest.js",
      "sw.js"
    ],
    "rules": {
      "tags": ["recommended"],
      "exclude": [
        "no-unused-vars",
        "no-empty",
        "no-window",
        "no-window-prefix",
        "prefer-const",
        "no-var",
        "no-this-alias",
        "no-inner-declarations"
      ]
    }
  }
}
