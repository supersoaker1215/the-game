#!/bin/sh
# Stamp the cache before every commit, so a deploy can never go out invisible.
#
# Shipping this game means bumping TWO things: the `?v=N` on each changed file
# in index.html, and CACHE_VERSION in sw.js. The `?v=` alone is not enough — a
# returning player's service worker keeps serving the old CODE_CACHE until
# CACHE_VERSION changes, so they stay on stale code and re-report bugs that were
# fixed days ago.
#
# Measured over 30 days before this hook existed: 42 of 343 commits that touched
# engine JS shipped with no sw.js bump. One deploy in eight.
#
# Runs tools/stamp-cache.js, which is idempotent — a commit that changed nothing
# versioned is untouched, so this is silent the vast majority of the time.
#
# Lives in .git/hooks/, which git does NOT track. A fresh clone installs it with:
#   cp tools/pre-commit.sample .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# (core.hooksPath is deliberately NOT used — it would redirect every hook and
# disable the post-commit auto-push that already lives here.)

JSC=/System/Library/Frameworks/JavaScriptCore.framework/Versions/Current/Helpers/jsc
[ -x "$JSC" ] || exit 0                       # no jsc (not macOS) — don't block the commit
[ -f tools/stamp-cache.js ] || exit 0

# ---- THE STAMPER HASHES THE WORKING TREE, AND A COMMIT SHIPS THE INDEX ------
# Those are the same file in the normal flow and different ones the moment you
# stage part of your work. Partially staged, the stamper reads a file that is
# NOT in this commit, bumps its ?v= and records its hash — so the commit that
# later actually carries that content sees a matching hash, gets no bump, and
# ships invisible. That is the exact failure this hook exists to prevent,
# arriving through the hook itself.
#
# Reproduced before this guard: with ai.js staged and tricks.js edited but NOT
# staged, the hook bumped tricks.js v124 → v125 and wrote its new hash into the
# manifest, in a commit containing no tricks.js at all.
#
# Rather than guess which content will ship, refuse when they disagree. When
# every versioned asset is fully staged — the normal case — working tree and
# index are identical and hashing the working tree is exactly right.
VERSIONED=$(grep -oE '(src|href)="[^"]+\?v=[0-9]+"' index.html 2>/dev/null \
            | sed 's/.*="//; s/?v=[0-9]*"$//' | sort -u)
DIRTY=""
for f in $VERSIONED; do
  if ! git diff --quiet -- "$f" 2>/dev/null; then
    DIRTY="$DIRTY $f"
  fi
done
if [ -n "$DIRTY" ]; then
  echo "[cache-stamp] BLOCKED — these versioned files differ between your"
  echo "[cache-stamp] working tree and what you are committing:"
  for f in $DIRTY; do echo "[cache-stamp]     $f"; done
  echo "[cache-stamp]"
  echo "[cache-stamp] The stamp has to describe the content that SHIPS. Stamping"
  echo "[cache-stamp] a half-staged tree records a hash for content this commit"
  echo "[cache-stamp] does not contain, and the commit that later carries it"
  echo "[cache-stamp] would then be skipped — a deploy nobody sees."
  echo "[cache-stamp]"
  echo "[cache-stamp] Stage them (git add) or stash them, then commit again."
  exit 1
fi

OUT=$("$JSC" tools/stamp-cache.js 2>&1)
STATUS=$?
if [ $STATUS -ne 0 ]; then
  echo "[cache-stamp] FAILED — commit blocked so a stale deploy can't ship:"
  echo "$OUT"
  exit 1
fi

# Only say something when it actually did something.
if echo "$OUT" | grep -q "bumped\|adopted"; then
  echo "$OUT" | sed 's/^/[cache-stamp] /'
  git add index.html sw.js tools/cache-stamp.json 2>/dev/null
fi
exit 0
